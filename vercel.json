{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "corporacionaquaswim.com" }],
      "destination": "https://www.corporacionaquaswim.com/:path*",
      "permanent": true
    },
    { "source": "/inicio", "destination": "/", "permanent": true },
    { "source": "/qui%C3%A9nes-somos", "destination": "/#institucional", "permanent": true },
    { "source": "/quienes-somos", "destination": "/#institucional", "permanent": true },
    { "source": "/servicios", "destination": "/#programas", "permanent": true },
    { "source": "/servicios/:programa*", "destination": "/#programas", "permanent": true },
    { "source": "/inscripciones", "destination": "/#inscripciones", "permanent": true },
    { "source": "/pagos", "destination": "/", "permanent": true },
    { "source": "/dian", "destination": "/", "permanent": true },
    { "source": "/blog/:ruta*", "destination": "/", "permanent": true },
    { "source": "/blog", "destination": "/", "permanent": true },
    { "source": "/ranking", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
